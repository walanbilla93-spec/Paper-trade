# Orayan Backend v2 — Northflank variables

PORT=3000

# Bybit credentials. Use TESTNET keys while testing.
BYBIT_API_KEY=your_testnet_key
BYBIT_API_SECRET=your_testnet_secret

# Bot mode:
# PAPER_REAL_PRICE       = do not send orders to Bybit (not fully enabled in v2 UI yet)
# TESTNET_BYBIT_PRICE   = use Bybit testnet prices + testnet orders
# LIVE_REAL_BYBIT       = live Bybit trading. Locked unless ALLOW_LIVE_TRADING=true
BOT_MODE=TESTNET_BYBIT_PRICE
BYBIT_TESTNET=true

# Master safety switch. Default should stay false until you are ready.
AUTO_TRADE_ENABLED=false
TRADING_ENABLED=false

# Only needed for real-money mode. Keep false/missing during testnet.
ALLOW_LIVE_TRADING=false

# Risk settings
MAX_TRADE_USDT=10
LEVERAGE=3
MAX_OPEN_TRADES=10
MIN_SCORE_TO_TRADE=55
COOLDOWN_MINUTES=60
PENDING_TIMEOUT_MINUTES=360

# In testnet, market orders avoid the real-price/testnet-price mismatch.
MARKET_ORDERS_ON_TESTNET=true
ORDER_TYPE=Market

# Optional protection for backend endpoints. If set, put same value in app settings.
AUTH_TOKEN=

# Data location. Mount a persistent volume to /app/data on Northflank if possible.
DATA_DIR=/app/data

# v3 safety lock. Keep false unless you intentionally want to unlock real-money live mode.
CONFIRM_LIVE_TRADING=false


# ORAYAN v4.6 Elliott wave + strategy hardening defaults
BOT_MODE=PAPER_REAL_PRICE
TRADING_ENABLED=false
BYBIT_TESTNET=true
MAX_TRADE_USDT=10
LEVERAGE=5
MAX_OPEN_TRADES=10
MIN_SCORE_TO_TRADE=84
COOLDOWN_MINUTES=60
PENDING_TIMEOUT_MINUTES=360
V4_MIN_RR=2.0
V4_MIN_SELL_RR=2.0
V4_MIN_SL_DISTANCE_PCT=0.60
V4_REJECT_MIXED_BTC_REGIME=true
V4_REJECT_MILD_EXTENSION=true
V4_REJECT_MOMENTUM_CONFLICT=true
V4_ENTRY_CONFIRMATION_REQUIRED=true
V4_ELLIOTT_WAVE_FILTER=true
V4_REJECT_ELLIOTT_CONFLICT=true
V4_CLUSTER_LOSS_COUNT=2
V4_CLUSTER_LOSS_WINDOW_MINUTES=30
V4_CLUSTER_LOSS_COOLDOWN_MINUTES=60
V4_SYMBOL_LOSS_LOCKOUT_MINUTES=60
V4_SYMBOL_SESSION_LOCKOUT_LOSSES=2
ONE_TRADE_PER_SYMBOL=true
REJECT_UNKNOWN_BTC_REGIME=false
REJECT_TREND_CONFLICT=true
REJECT_RSI_CONFLICT=true
REJECT_VOLUME_DELTA_CONFLICT=true
PUBLIC_BACKEND_URL=https://p01--bybit-back--rpfg4d97xnm6.code.run


# ORAYAN v4.6.8 architecture/entry hardening
V4_BACKEND_ONLY=true
V4_ENTRY_TOLERANCE_ATR=0.25
V4_ENTRY_TOLERANCE_MIN_PCT=0.08
V4_ENTRY_TOLERANCE_MAX_PCT=0.35
V4_ENTRY_REACTION_BPS=8
V4_ENTRY_REACTION_ATR=0.10
V4_ENTRY_CONFIRMATION_WINDOW_SECONDS=10
V4_NORMAL_SL_ATR_MULT=0.35
V4_MEME_SL_ATR_MULT=0.45

# v4.6.8 duplicate/waiting cleanup
V4_SYMBOL_WIN_COOLDOWN_MINUTES=20
V4_SYMBOL_LOSS_LOCKOUT_MINUTES=60
V4_WAITING_REFRESH_MAX_ENTRY_WORSE_PCT=0.15
V4_WAITING_REFRESH_MIN_SCORE_DELTA=0
