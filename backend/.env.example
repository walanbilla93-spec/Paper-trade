# Orayan Backend v2 — Northflank variables

PORT=3000

# Bybit credentials. Use TESTNET keys while testing.
BYBIT_API_KEY=your_testnet_key
BYBIT_API_SECRET=your_testnet_secret

# Bot mode:
# PAPER_REAL_PRICE       = do not send orders to Bybit (not fully enabled in v2 UI yet)
# TESTNET_BYBIT_PRICE   = use Bybit testnet prices + testnet orders
# LIVE_REAL_BYBIT       = live Bybit trading. Locked unless ALLOW_LIVE_TRADING=true
BOT_MODE=TESTNET_BYBIT_PRICE
BYBIT_TESTNET=true

# Master safety switch. Default should stay false until you are ready.
AUTO_TRADE_ENABLED=false
TRADING_ENABLED=false

# Only needed for real-money mode. Keep false/missing during testnet.
ALLOW_LIVE_TRADING=false

# Risk settings
MAX_TRADE_USDT=10
LEVERAGE=3
MAX_OPEN_TRADES=10
MIN_SCORE_TO_TRADE=55
COOLDOWN_MINUTES=30
PENDING_TIMEOUT_MINUTES=360

# In testnet, market orders avoid the real-price/testnet-price mismatch.
MARKET_ORDERS_ON_TESTNET=true
ORDER_TYPE=Market

# Optional protection for backend endpoints. If set, put same value in app settings.
AUTH_TOKEN=

# Data location. Mount a persistent volume to /app/data on Northflank if possible.
DATA_DIR=/app/data

# v3 safety lock. Keep false unless you intentionally want to unlock real-money live mode.
CONFIRM_LIVE_TRADING=false
