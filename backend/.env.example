# Orayan Backend v4.3 — safe paper defaults

PORT=3000
PUBLIC_BACKEND_URL=https://p01--bybit-back--rpfg4d97xnm6.code.run

# Bybit credentials. Keep API keys only in backend env variables.
BYBIT_API_KEY=your_testnet_key
BYBIT_API_SECRET=your_testnet_secret

# Safe default: paper trading on real market prices, no Bybit orders.
BOT_MODE=PAPER_REAL_PRICE
BYBIT_TESTNET=true
AUTO_TRADE_ENABLED=false
TRADING_ENABLED=false
CONFIRM_LIVE_TRADING=false

# Risk/settings defaults from mobile settings panel.
MAX_TRADE_USDT=10
LEVERAGE=5
MAX_OPEN_TRADES=10
MIN_SCORE_TO_TRADE=70
COOLDOWN_MINUTES=30
PENDING_TIMEOUT_MINUTES=360

# Testnet/order behaviour.
MARKET_ORDERS_ON_TESTNET=true
ORDER_TYPE=Market

# v4 planner/safety filters.
SAFE_MODE=true
ONE_TRADE_PER_SYMBOL=true
REJECT_UNKNOWN_BTC_REGIME=true
REJECT_TREND_CONFLICT=true
REJECT_RSI_CONFLICT=true
REJECT_VOLUME_DELTA_CONFLICT=true
V4_MIN_RR=1.9
V4_SIGNAL_EXPIRY_MINUTES=45
V4_SCAN_INTERVAL_MS=20000
V4_SCAN_SYMBOLS=80
V4_MAX_SIGNALS=120
ORAYAN_SIGNAL_WIN_AT=TP1
ORAYAN_SAME_TICK_POLICY=LOSS

# Optional protection for backend endpoints. If set, put same value in app settings.
AUTH_TOKEN=

# Data location. Mount a persistent volume to /app/data on Northflank if possible.
DATA_DIR=/app/data
