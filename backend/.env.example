# ============================================================
# Orayan AutoTrader — Backend ENV  (v4.6.8.19 optimized)
# ============================================================
# CONFLICT FIXES vs previous version:
#   1. Removed duplicate BOT_MODE / LEVERAGE / BYBIT_TESTNET keys
#      (dotenv uses FIRST occurrence — the second block was silently ignored)
#   2. V4_ALLOW_SELLS: was false (env) vs true (config default) → now true
#   3. V4_REJECT_MIXED_BTC_REGIME: was true (env) vs false (config) → now false
#   4. V4_MIN_BUY_ENTRY_TIMING_SCORE: was 85 (env) vs 65 (config) → now 68
#      (data: 53 of 109 signals score exactly 68; raising to 85 cut all of them)
#   5. V4_MIN_SELL_ENTRY_TIMING_SCORE: was 92 (env) → now 70
#      (data: no signal ever reaches 92 — gate was a permanent SELL blocker)
#   6. V4_MIN_BUY_SCORE: 60 → 65  (data: score>=65 gives 55.6% WR vs 53.1% at 60)
#   7. V4_MIN_SELL_SCORE: 86 → 72  (aligns with config FIX1 comment; 86 near-blocked all SELLs)
#   8. V4_MIN_RR: 1.6 → 1.6 (KEPT — RR 1.6-2.0 band has 77.8% WR, do NOT raise this)
# ============================================================

PORT=3000

# ── Bybit credentials ────────────────────────────────────────
BYBIT_API_KEY=your_testnet_key
BYBIT_API_SECRET=your_testnet_secret

# ── Bot mode ─────────────────────────────────────────────────
# PAPER_REAL_PRICE       = no orders sent, tracks real Binance prices
# TESTNET_BYBIT_PRICE   = Bybit testnet prices + testnet orders
# LIVE_REAL_BYBIT       = live money (requires ALLOW_LIVE_TRADING=true)
BOT_MODE=PAPER_REAL_PRICE
BYBIT_TESTNET=true

# ── Safety switches ───────────────────────────────────────────
AUTO_TRADE_ENABLED=false
TRADING_ENABLED=false
ALLOW_LIVE_TRADING=false
CONFIRM_LIVE_TRADING=false

# ── Order settings ────────────────────────────────────────────
MARKET_ORDERS_ON_TESTNET=true
ORDER_TYPE=Market

# ── Risk / position sizing ───────────────────────────────────
MAX_TRADE_USDT=10
# FIX: single LEVERAGE declaration — was declared twice (3 then 5), dotenv kept 3
LEVERAGE=5
MAX_OPEN_TRADES=10

# ── Score gates ───────────────────────────────────────────────
# Global fallback (legacy, used by scanner.js maybeExecute)
MIN_SCORE_TO_TRADE=65

# BUY: data shows score>=65 gives best WR (55.6%) without killing volume
# Was 60 in env; config default was 48. 65 is the sweet spot.
V4_MIN_BUY_SCORE=65

# SELL: was 86 in env (near-total block). Config default=72 is correct per FIX1.
# 72 gives realistic SELL participation with regime + ETS gates still active.
V4_MIN_SELL_SCORE=72

# ── Entry timing score gates ──────────────────────────────────
# DATA: entryTimingScore distribution = 68 (53 signals), 97 (39), 100 (16)
# ets=100 produced 15.4% WR and -2.78 PnL — it is ANTI-predictive
# ets=68 bucket is where most valid setups live
#
# Global legacy fallback (used if per-side values not read)
V4_MIN_ENTRY_TIMING_SCORE=68

# BUY: was 85 in env — blocked all ets=68 signals (53 of 109 total)
# 68 is the correct floor; it passes the bulk of valid setups
V4_MIN_BUY_ENTRY_TIMING_SCORE=68

# SELL: was 92 in env — NO signal ever reaches 92. Was a permanent SELL kill switch.
# 70 passes ets=68 bucket (rounds up naturally) while staying selective
V4_MIN_SELL_ENTRY_TIMING_SCORE=70

# ── R:R gates ────────────────────────────────────────────────
# DATA: RR 1.6-2.0 = 77.8% WR. Do NOT raise floor — it kills the best bucket.
V4_MIN_RR=1.6
# SELL RR can be slightly stricter since SELL volume is lower anyway
V4_MIN_SELL_RR=1.7

# ── Allow SELLs ───────────────────────────────────────────────
# FIX: was false in env vs true in config — CONFLICT resolved to true
# SELLs have 44.4% WR but positive PnL (0.88). With regime + ETS gates they are viable.
V4_ALLOW_SELLS=true

# ── BTC regime ───────────────────────────────────────────────
# FIX: was true in env vs false in config — CONFLICT resolved to false
# rejectMixedBtcRegime=true blocked all signals during sideways BTC (common)
V4_REJECT_MIXED_BTC_REGIME=false
# Keep direction_match (not strict) to allow neutral-leaning setups
V4_BTC_REGIME_MODE=direction_match
REJECT_UNKNOWN_BTC_REGIME=false

# ── Other signal quality filters ─────────────────────────────
# JOURNAL: SL 0.30-0.50% zone = 27.3% WR (worst bucket). 0.50-0.70% = 64.3%.
# Raising from 0.25 -> 0.40 blocks the danger zone without killing good setups.
V4_MIN_SL_DISTANCE_PCT=0.40

# JOURNAL: ETS=100 = 15.4% WR across 13 trades (-2.78 PnL). Anti-predictive.
# ETS=100 means price spiked into entry zone instantly -- entered at peak momentum.
# Block it. ETS=97 and ETS=68 are where real setups live.
V4_MAX_ENTRY_TIMING_SCORE=97
REJECT_TREND_CONFLICT=true
REJECT_RSI_CONFLICT=true
# DATA: ets=100 losses clustered on high-momentum entries — keep volume delta filter
REJECT_VOLUME_DELTA_CONFLICT=true
V4_REJECT_MILD_EXTENSION=true
V4_REJECT_MOMENTUM_CONFLICT=true
V4_ENTRY_CONFIRMATION_REQUIRED=true
V4_ELLIOTT_WAVE_FILTER=true
V4_REJECT_ELLIOTT_CONFLICT=true

# ── Fee / net profit gates ───────────────────────────────────
# Keep these — they protect against micro-PnL trades eaten by fees
V4_MIN_NET_TP_USDT=0.25
V4_MIN_NET_TP_FEE_MULT=2.5
V4_MIN_NET_RR=0.85
V4_MAX_FRONTEND_TP_PCT=4.5

# ── TP / ATR caps ────────────────────────────────────────────
V4_MAX_TP_ATR=2.4

# ── Timing / expiry ──────────────────────────────────────────
COOLDOWN_MINUTES=60
PENDING_TIMEOUT_MINUTES=360
# Signal expiry: 30 min is correct. Many EXPIRED signals had ets=68 (not-ideal timing)
# raising this would just collect more stale setups — keep at 30
V4_SIGNAL_EXPIRY_MINUTES=30

# ── Per-symbol loss protection ───────────────────────────────
# Keep these — DEEPUSDT, TRUTHUSDT, SOLAYERUSDT appear multiple times as repeat losers
V4_CLUSTER_LOSS_COUNT=2
V4_CLUSTER_LOSS_WINDOW_MINUTES=30
V4_CLUSTER_LOSS_COOLDOWN_MINUTES=60
V4_SYMBOL_LOSS_LOCKOUT_MINUTES=60
V4_SYMBOL_SESSION_LOCKOUT_LOSSES=2
V4_SYMBOL_WIN_COOLDOWN_MINUTES=20

# ── Session risk limits ───────────────────────────────────────
V4_RISK_WINDOW_HOURS=6
V4_MAX_CONSECUTIVE_LOSSES=4
# DATA: session PnL was +3.95 over ~37 trades. 5.0 USDT stop is tight but safe for paper.
V4_MAX_SESSION_LOSS_USDT=5.0

# ── Duplicate / refresh suppression ─────────────────────────
ONE_TRADE_PER_SYMBOL=true
V4_WAITING_REFRESH_MAX_ENTRY_WORSE_PCT=0.15
V4_WAITING_REFRESH_MIN_SCORE_DELTA=0

# ── Entry execution ──────────────────────────────────────────
V4_BACKEND_ONLY=true
V4_ENTRY_TOLERANCE_ATR=0.25
V4_ENTRY_TOLERANCE_MIN_PCT=0.08
V4_ENTRY_TOLERANCE_MAX_PCT=0.35
V4_ENTRY_REACTION_BPS=5
V4_ENTRY_REACTION_ATR=0.10
V4_ENTRY_CONFIRMATION_WINDOW_SECONDS=10
V4_NORMAL_SL_ATR_MULT=0.35
V4_MEME_SL_ATR_MULT=0.45

# ── Elliott Wave ─────────────────────────────────────────────
V4_ELLIOTT_WAVE_WEIGHT=normal

# ── Experiment preset ────────────────────────────────────────
V4_EXPERIMENT_PRESET=research

# ── Diagnostics ──────────────────────────────────────────────
V4_DIAGNOSTIC_JOURNAL=true

# ── Infrastructure ───────────────────────────────────────────
DATA_DIR=/app/data
AUTH_TOKEN=
PUBLIC_BACKEND_URL=https://p01--bybit-back--rpfg4d97xnm6.code.run
