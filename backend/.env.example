# Orayan Backend v4.6.8.19 — example environment
# This file is a template only. Editing .env.example will NOT reset paper trades.
# Live behavior uses your actual environment variables / .env file plus saved backend settings.

# -----------------------------------------------------------------------------
# Server / URLs
# -----------------------------------------------------------------------------
PORT=3000
PUBLIC_BACKEND_URL=https://p01--bybit-back--rpfg4d97xnm6.code.run
DATA_DIR=/app/data
AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Bybit credentials
# Use TESTNET keys while testing. Leave blank in pure paper mode if not needed.
# -----------------------------------------------------------------------------
BYBIT_API_KEY=your_testnet_key
BYBIT_API_SECRET=your_testnet_secret
BYBIT_TESTNET=true
SYMBOL_SETTLE_COIN=USDT

# -----------------------------------------------------------------------------
# Trading mode / safety
# PAPER_REAL_PRICE      = no real Bybit orders; uses real market prices for paper tracking
# TESTNET_BYBIT_PRICE  = testnet orders/prices
# LIVE_REAL_BYBIT      = real orders; blocked unless CONFIRM_LIVE_TRADING=true
# -----------------------------------------------------------------------------
BOT_MODE=PAPER_REAL_PRICE
AUTO_TRADE_ENABLED=false
TRADING_ENABLED=false
CONFIRM_LIVE_TRADING=false

# In testnet, market orders avoid real-price/testnet-price mismatch.
ORDER_TYPE=Market
MARKET_ORDERS_ON_TESTNET=true

# -----------------------------------------------------------------------------
# Position / risk defaults — synced with backend/lib/config.js DEFAULTS
# -----------------------------------------------------------------------------
MAX_TRADE_USDT=10
LEVERAGE=5
MAX_OPEN_TRADES=10
COOLDOWN_MINUTES=60
PENDING_TIMEOUT_MINUTES=360
DEFAULT_RISK_PCT=0.006
DEFAULT_REWARD_PCT=0.012
USE_SIGNAL_TP_SL_PERCENT=true
SAFE_MODE=true
ONE_TRADE_PER_SYMBOL=true
MIN_TURNOVER_24H=0
MAX_SIGNAL_AGE_MINUTES=5

# -----------------------------------------------------------------------------
# v4 diagnosis/balanced gates — synced with backend/lib/config.js DEFAULTS
# -----------------------------------------------------------------------------
MIN_SCORE_TO_TRADE=84
V4_MIN_BUY_SCORE=48
V4_MIN_SELL_SCORE=72
V4_ALLOW_SELLS=true
V4_MIN_RR=1.6
V4_MIN_SELL_RR=1.7
V4_MIN_ENTRY_TIMING_SCORE=85
V4_MIN_BUY_ENTRY_TIMING_SCORE=65
V4_MIN_SELL_ENTRY_TIMING_SCORE=70
V4_MIN_SL_DISTANCE_PCT=0.25

# Fee-safe target rules
V4_MIN_NET_TP_USDT=0.25
V4_MIN_NET_TP_FEE_MULT=2.5
V4_MIN_NET_RR=0.85
V4_MAX_FRONTEND_TP_PCT=4.5
V4_MAX_TP_ATR=2.4

# Entry confirmation / waiting-state rules
V4_BACKEND_ONLY=true
V4_ENTRY_TOLERANCE_ATR=0.25
V4_ENTRY_TOLERANCE_MIN_PCT=0.08
V4_ENTRY_TOLERANCE_MAX_PCT=0.35
V4_ENTRY_REACTION_BPS=5
V4_ENTRY_REACTION_ATR=0.10
V4_ENTRY_CONFIRMATION_WINDOW_SECONDS=10
V4_SIGNAL_EXPIRY_MINUTES=30
V4_SYMBOL_COOLDOWN_MINUTES=60
V4_SYMBOL_WIN_COOLDOWN_MINUTES=20
V4_WAITING_REFRESH_MAX_ENTRY_WORSE_PCT=0.15
V4_WAITING_REFRESH_MIN_SCORE_DELTA=0

# Market/regime filters
REJECT_UNKNOWN_BTC_REGIME=false
REJECT_TREND_CONFLICT=true
REJECT_RSI_CONFLICT=true
REJECT_VOLUME_DELTA_CONFLICT=true
V4_REJECT_MIXED_BTC_REGIME=false
V4_REJECT_MILD_EXTENSION=true
V4_REJECT_MOMENTUM_CONFLICT=true
V4_ENTRY_CONFIRMATION_REQUIRED=true
V4_ELLIOTT_WAVE_FILTER=true
V4_REJECT_ELLIOTT_CONFLICT=true
V4_BTC_REGIME_MODE=direction_match
V4_ELLIOTT_WAVE_WEIGHT=normal
V4_EXPERIMENT_PRESET=balanced

# Stop/circuit breaker defaults
V4_RISK_WINDOW_HOURS=6
V4_MAX_CONSECUTIVE_LOSSES=5
V4_MAX_SESSION_LOSS_USDT=5.0
V4_CLUSTER_LOSS_COUNT=2
V4_CLUSTER_LOSS_WINDOW_MINUTES=30
V4_CLUSTER_LOSS_COOLDOWN_MINUTES=30
V4_SYMBOL_LOSS_LOCKOUT_MINUTES=60
V4_SYMBOL_SESSION_LOCKOUT_LOSSES=2

# Diagnostics / persistence
V4_DIAGNOSTIC_JOURNAL=true
V4_MAX_DIAGNOSTIC_ROWS=5000
V4_MAX_LEDGER=5000
V4_RECENT_LEDGER_LIMIT=250

# Scanner / market data
V4_SCAN_INTERVAL_MS=20000
V4_SCAN_SYMBOLS=80
V4_MAX_SIGNALS=120
V4_MARKET_BASE_URL=https://api.bybit.com
BACKEND_SCAN_INTERVAL_MS=15000
BACKEND_SCAN_SYMBOLS=55
BACKEND_LEADERBOARD_LIMIT=80
SCAN_INTERVAL_MS=15000

# Fees/slippage model used by diagnostics and net TP checks
V4_FEE_RATE=0.0006
V4_SLIPPAGE_RATE=0.0004

# TP/SL structure helpers
V4_NORMAL_SL_ATR_MULT=0.35
V4_MEME_SL_ATR_MULT=0.45

# Score labels / caps used by v4Brain diagnostics
V4_SCORE_A_PLUS=90
V4_SCORE_A=84
V4_SCORE_B=80
V4_MAX_SCORE_WITH_RISK=82
V4_MAX_SCORE_IF_ENTRY_FAR_ATR=78
V4_MAX_SCORE_IF_NO_FULL_TREND=78

# State-machine behavior
ORAYAN_SIGNAL_WIN_AT=TP1
ORAYAN_SAME_TICK_POLICY=LOSS
